<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Phillip Berryman</Copyright>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.AsterChannels</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Description>A Channels page in the Jellyfin dashboard for Aster Media Player's TV channels.</Description>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/channelsPage.html" />
    <EmbeddedResource Include="Web/channel-tags.js" />
    <EmbeddedResource Include="Web/channels.js" />
  </ItemGroup>

</Project>
