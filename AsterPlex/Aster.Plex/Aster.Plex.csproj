<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aster.Plex</RootNamespace>
    <AssemblyName>Aster.Plex</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Copyright>Copyright (C) 2026 Phillip Berryman</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Description>Aster for Plex: tracking, Add to Watchlist and Channels for Aster Media Player on a Plex server, in a container beside it.</Description>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aster.Plex.Tests" />
  </ItemGroup>

  <!-- Aster's own apps on each service, for official images only (see BuiltInKeys.cs), as in the Jellyfin plugin. -->
  <ItemGroup>
    <AssemblyMetadata Include="AsterKey.SimklClientId" Value="$(ASTER_SIMKL_CLIENT_ID)" Condition="'$(ASTER_SIMKL_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="AsterKey.AniListClientId" Value="$(ASTER_ANILIST_CLIENT_ID)" Condition="'$(ASTER_ANILIST_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="AsterKey.MyAnimeListClientId" Value="$(ASTER_MAL_CLIENT_ID)" Condition="'$(ASTER_MAL_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="AsterKey.HardcoverClientId" Value="$(ASTER_HARDCOVER_CLIENT_ID)" Condition="'$(ASTER_HARDCOVER_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="AsterKey.LastFmApiKey" Value="$(ASTER_LASTFM_API_KEY)" Condition="'$(ASTER_LASTFM_API_KEY)' != ''" />
    <AssemblyMetadata Include="AsterKey.LastFmSharedSecret" Value="$(ASTER_LASTFM_SHARED_SECRET)" Condition="'$(ASTER_LASTFM_SHARED_SECRET)' != ''" />
  </ItemGroup>

</Project>
