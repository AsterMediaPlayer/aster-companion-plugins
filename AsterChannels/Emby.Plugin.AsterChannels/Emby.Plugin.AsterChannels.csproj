<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aster Channels for Emby: the same Channels dashboard page as the Jellyfin plugin, built on Emby's SDK.
       Built against Emby 4.8's SDK so it loads on Emby 4.8 and later. -->
  <PropertyGroup>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Phillip Berryman</Copyright>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Emby.Plugin.AsterChannels</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Description>A Channels page in the Emby dashboard for Aster Media Player's TV channels.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.8.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/channelsPage.html" />
    <EmbeddedResource Include="Configuration/channelsPage.js" />
    <EmbeddedResource Include="Web/channels.js" />
    <!-- One copy of the tag rules for both plugins: the Jellyfin plugin's, which its tests check against the app's. -->
    <EmbeddedResource Include="../Jellyfin.Plugin.AsterChannels/Web/channel-tags.js" LogicalName="Emby.Plugin.AsterChannels.Web.channel-tags.js" />
  </ItemGroup>

</Project>
