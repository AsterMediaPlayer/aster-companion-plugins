{
  "kinds": {
    "document": {
      "title": "Whole menu",
      "order": [
        "root",
        "match",
        "meta",
        "background",
        "theme",
        "audio",
        "layout"
      ],
      "fields": {
        "menuId": {
          "hidden": true
        },
        "revision": {
          "hidden": true
        },
        "extras": {
          "hidden": true
        },
        "menus": {
          "hidden": true
        },
        "root": {
          "label": "Menu shown first",
          "control": "menuKey"
        },
        "match": {
          "label": "Which title this is for"
        },
        "meta": {
          "label": "About this menu",
          "create": {}
        },
        "background": {
          "label": "Default background (for every page)",
          "create": {
            "source": "jellyfin",
            "imageType": "Backdrop",
            "dim": 0.4
          }
        },
        "theme": {
          "label": "Colours and text (for every page)",
          "create": {
            "id": "list-dark"
          }
        },
        "audio": {
          "label": "Music and sounds (for every page)",
          "create": {}
        },
        "layout": {
          "label": "Layout (for every page)",
          "create": {}
        }
      },
      "basic": [
        "root"
      ],
      "moreLabel": "Settings for the whole menu (background, colours, sounds, layout)",
      "moreAuto": false,
      "hint": "Choose a page from the list on the left to change its buttons."
    },
    "meta": {
      "title": "About this menu",
      "order": [
        "author",
        "language",
        "notes",
        "created",
        "updated"
      ],
      "fields": {
        "author": {
          "label": "Author"
        },
        "language": {
          "label": "Language of the labels",
          "help": "A language code such as en or pt-BR."
        },
        "notes": {
          "label": "Notes"
        },
        "created": {
          "label": "Created",
          "hidden": true
        },
        "updated": {
          "label": "Updated",
          "hidden": true
        }
      }
    },
    "match": {
      "title": "Which title this is for",
      "order": [
        "itemType",
        "seasonNumber",
        "providerIds",
        "release"
      ],
      "fields": {
        "itemType": {
          "label": "Kind of title"
        },
        "seasonNumber": {
          "label": "Season number",
          "help": "Needed when the kind of title is Season."
        },
        "providerIds": {
          "label": "Provider ids",
          "create": {
            "Tmdb": ""
          }
        },
        "release": {
          "label": "Which release (edition, format...)",
          "create": {}
        }
      }
    },
    "providerIds": {
      "title": "Provider ids",
      "fields": {
        "Tmdb": {
          "label": "TMDB id"
        },
        "Imdb": {
          "label": "IMDB id"
        },
        "Tvdb": {
          "label": "TVDB id"
        }
      }
    },
    "release": {
      "title": "Which release",
      "order": [
        "edition",
        "format",
        "region",
        "year",
        "publisher",
        "upc"
      ],
      "fields": {
        "edition": {
          "label": "Edition"
        },
        "format": {
          "label": "Format"
        },
        "region": {
          "label": "Region"
        },
        "year": {
          "label": "Release year"
        },
        "publisher": {
          "label": "Publisher"
        },
        "upc": {
          "label": "UPC (barcode)"
        }
      }
    },
    "menu": {
      "title": "Page",
      "order": [
        "title",
        "entries",
        "background",
        "theme",
        "layout",
        "audio"
      ],
      "fields": {
        "title": {
          "label": "Title"
        },
        "entries": {
          "label": "Buttons"
        },
        "background": {
          "label": "Background (this page only)",
          "create": {
            "source": "jellyfin",
            "imageType": "Backdrop",
            "dim": 0.4
          }
        },
        "theme": {
          "label": "Colours and text (this page only)",
          "create": {
            "id": "list-dark"
          }
        },
        "layout": {
          "label": "Layout (this page only)",
          "create": {}
        },
        "audio": {
          "label": "Music and sounds (this page only)",
          "create": {}
        }
      },
      "basic": [
        "title",
        "entries",
        "background"
      ],
      "moreLabel": "More for this page (colours, layout, music)",
      "moreAuto": false,
      "hint": "Choose a button to change it, or add a new one."
    },
    "entry": {
      "title": "Button",
      "order": [
        "action",
        "label",
        "extra",
        "extras",
        "menu",
        "startChapter",
        "perPage",
        "style",
        "position",
        "image",
        "imageFocus"
      ],
      "fields": {
        "action": {
          "label": "What it does"
        },
        "label": {
          "label": "Text on the button"
        },
        "extra": {
          "label": "Extra to play",
          "control": "extraKey"
        },
        "extras": {
          "label": "Extras to play, in order",
          "control": "extraKeys"
        },
        "menu": {
          "label": "Page to open",
          "control": "menuKey"
        },
        "startChapter": {
          "label": "Start at chapter"
        },
        "perPage": {
          "label": "Scenes per page",
          "default": 6
        },
        "style": {
          "label": "Look of the button"
        },
        "position": {
          "label": "Place on the screen",
          "create": {
            "x": 10,
            "y": 10
          }
        },
        "image": {
          "label": "Picture for the button"
        },
        "imageFocus": {
          "label": "Picture when highlighted"
        }
      },
      "basic": [
        "action",
        "label",
        "extra",
        "extras",
        "menu",
        "startChapter",
        "perPage"
      ],
      "moreLabel": "Look and position of this button",
      "hint": "Changes show in the preview straight away."
    },
    "background": {
      "title": "Background",
      "order": [
        "source",
        "imageType",
        "index",
        "tmdbFilePath",
        "tmdbSize",
        "fanartId",
        "image",
        "trailerIndex",
        "muted",
        "poster",
        "color",
        "dim"
      ],
      "fields": {
        "source": {
          "label": "Where the picture comes from"
        },
        "imageType": {
          "label": "Which of the title's pictures",
          "appliesTo": [
            "jellyfin"
          ]
        },
        "index": {
          "label": "Picture number (when there are several)",
          "appliesTo": [
            "jellyfin"
          ],
          "default": 0
        },
        "tmdbFilePath": {
          "label": "TMDB picture",
          "appliesTo": [
            "tmdb"
          ],
          "placeholder": "/abc123.jpg",
          "control": "tmdb"
        },
        "tmdbSize": {
          "label": "TMDB picture size",
          "appliesTo": [
            "tmdb"
          ],
          "default": "w1280"
        },
        "fanartId": {
          "label": "fanart.tv picture id",
          "appliesTo": [
            "fanart"
          ],
          "control": "fanart"
        },
        "image": {
          "label": "Picture",
          "appliesTo": [
            "image"
          ]
        },
        "trailerIndex": {
          "label": "Which trailer (0 is the first)",
          "appliesTo": [
            "trailer"
          ],
          "default": 0
        },
        "muted": {
          "label": "Muted",
          "appliesTo": [
            "trailer"
          ],
          "default": true
        },
        "poster": {
          "label": "Picture shown before the trailer plays",
          "appliesTo": [
            "trailer"
          ]
        },
        "color": {
          "label": "Colour",
          "appliesTo": [
            "*"
          ],
          "defaultValue": "#000000",
          "format": "color"
        },
        "dim": {
          "label": "Darkening (0 to 1)",
          "default": 0.4,
          "step": 0.05
        }
      },
      "basic": [
        "source",
        "dim"
      ]
    },
    "theme": {
      "title": "Colours and text",
      "order": [
        "id",
        "accent",
        "textColor",
        "font",
        "fontSize",
        "align",
        "uppercase",
        "bold",
        "letterSpacing"
      ],
      "fields": {
        "id": {
          "label": "Theme name"
        },
        "accent": {
          "label": "Highlight colour",
          "defaultValue": "#00a4dc"
        },
        "textColor": {
          "label": "Button text colour",
          "default": "white",
          "defaultValue": "#ffffff"
        },
        "font": {
          "label": "Font"
        },
        "fontSize": {
          "label": "Text size (% of screen height)",
          "step": 0.1
        },
        "align": {
          "label": "Text alignment"
        },
        "uppercase": {
          "label": "Capital letters"
        },
        "bold": {
          "label": "Bold"
        },
        "letterSpacing": {
          "label": "Letter spacing (em)",
          "step": 0.01
        }
      },
      "basic": [
        "id",
        "accent",
        "font"
      ]
    },
    "audio": {
      "title": "Music and sounds",
      "fields": {
        "music": {
          "label": "Background music",
          "create": {
            "source": "themeSong"
          }
        },
        "sounds": {
          "label": "Button sounds",
          "create": {
            "preset": "click"
          }
        }
      },
      "basic": [
        "music",
        "sounds"
      ]
    },
    "music": {
      "title": "Background music",
      "order": [
        "source",
        "file",
        "volume"
      ],
      "fields": {
        "source": {
          "label": "Music from"
        },
        "file": {
          "label": "Music file",
          "appliesTo": [
            "file"
          ]
        },
        "volume": {
          "label": "Volume (0 to 1)",
          "default": 0.5,
          "step": 0.05
        }
      }
    },
    "sounds": {
      "title": "Button sounds",
      "order": [
        "preset",
        "volume",
        "move",
        "select",
        "back"
      ],
      "fields": {
        "preset": {
          "label": "Built-in sounds"
        },
        "volume": {
          "label": "Volume (0 to 1)",
          "default": 0.5,
          "step": 0.05
        },
        "move": {
          "label": "Sound file when moving"
        },
        "select": {
          "label": "Sound file when choosing"
        },
        "back": {
          "label": "Sound file when going back"
        }
      },
      "basic": [
        "preset",
        "volume"
      ]
    },
    "layout": {
      "title": "Layout",
      "order": [
        "titlePosition",
        "hideTitle",
        "buttonStyle",
        "flow",
        "transition",
        "layers"
      ],
      "fields": {
        "titlePosition": {
          "label": "Where the title goes",
          "create": {
            "x": 50,
            "y": 8,
            "anchor": "top"
          }
        },
        "hideTitle": {
          "label": "Hide the title"
        },
        "buttonStyle": {
          "label": "Look of the buttons"
        },
        "flow": {
          "label": "Automatic grid of buttons",
          "create": {
            "region": {
              "x": 10,
              "y": 30,
              "w": 80,
              "h": 60
            },
            "columns": 2,
            "rows": 4
          }
        },
        "transition": {
          "label": "Animation between pages",
          "create": {
            "style": "fade"
          }
        },
        "layers": {
          "label": "Decorative layers",
          "createItem": {
            "type": "panel",
            "position": {
              "x": 0,
              "y": 0,
              "w": 100,
              "h": 15
            },
            "fill": "#000000",
            "opacity": 0.6
          }
        }
      },
      "basic": [
        "buttonStyle",
        "titlePosition",
        "hideTitle",
        "layers"
      ],
      "moreLabel": "Grid and animation"
    },
    "transition": {
      "title": "Animation between pages",
      "fields": {
        "style": {
          "label": "Animation"
        },
        "durationMs": {
          "label": "How long (milliseconds)",
          "default": 300
        }
      }
    },
    "flow": {
      "title": "Automatic grid of buttons",
      "order": [
        "region",
        "columns",
        "rows",
        "moreLabel",
        "previousLabel"
      ],
      "fields": {
        "region": {
          "label": "Area the grid fills",
          "create": {
            "x": 10,
            "y": 30,
            "w": 80,
            "h": 60
          }
        },
        "columns": {
          "label": "Columns"
        },
        "rows": {
          "label": "Rows"
        },
        "moreLabel": {
          "label": "Text of the More button",
          "default": "More"
        },
        "previousLabel": {
          "label": "Text of the Previous button",
          "default": "Previous"
        }
      }
    },
    "position": {
      "title": "Place on the screen",
      "order": [
        "x",
        "y",
        "w",
        "h",
        "anchor"
      ],
      "fields": {
        "x": {
          "label": "Across (%)",
          "step": 0.5
        },
        "y": {
          "label": "Down (%)",
          "step": 0.5
        },
        "w": {
          "label": "Width (%)",
          "step": 0.5
        },
        "h": {
          "label": "Height (%)",
          "step": 0.5
        },
        "anchor": {
          "label": "Which point of the item is placed",
          "default": "top-left"
        }
      },
      "basic": [
        "x",
        "y"
      ]
    },
    "layer": {
      "title": "Decorative layer",
      "order": [
        "type",
        "position",
        "fill",
        "opacity",
        "borderColor",
        "borderWidth",
        "radius",
        "image",
        "fit"
      ],
      "fields": {
        "type": {
          "label": "Kind of layer"
        },
        "position": {
          "label": "Place on the screen",
          "create": {
            "x": 0,
            "y": 0,
            "w": 100,
            "h": 15
          }
        },
        "fill": {
          "label": "Fill colour",
          "defaultValue": "#000000"
        },
        "opacity": {
          "label": "Opacity (0 to 1)",
          "step": 0.05
        },
        "borderColor": {
          "label": "Border colour",
          "defaultValue": "#ffffff"
        },
        "borderWidth": {
          "label": "Border width (% of screen height)",
          "step": 0.1
        },
        "radius": {
          "label": "Corner rounding (% of screen height)",
          "step": 0.5
        },
        "image": {
          "label": "Picture"
        },
        "fit": {
          "label": "How the picture fills its box",
          "default": "contain"
        }
      },
      "basic": [
        "type",
        "position",
        "fill",
        "image",
        "opacity"
      ],
      "hint": "A decorative shape or picture drawn behind the buttons."
    },
    "extra": {
      "title": "Extra",
      "order": [
        "type",
        "durationSec",
        "toleranceSec",
        "ordinal",
        "optional"
      ],
      "create": {
        "type": "Featurette",
        "durationSec": 60
      },
      "fields": {
        "type": {
          "label": "Kind of extra"
        },
        "durationSec": {
          "label": "Length (seconds)",
          "help": "How long the extra is. It is how the menu finds the right file."
        },
        "toleranceSec": {
          "label": "Allowed difference (seconds)",
          "default": 3
        },
        "ordinal": {
          "label": "Number among extras of the same kind"
        },
        "optional": {
          "label": "Fine if it is missing"
        }
      },
      "basic": [
        "type",
        "durationSec"
      ],
      "hint": "An extra the disc has. The length is how the menu finds the right file."
    }
  }
}
