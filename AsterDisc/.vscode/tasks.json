{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "validate schemas",
      "type": "shell",
      "command": "docker compose run --rm validate",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dotnet build",
      "type": "shell",
      "command": "docker compose exec dev dotnet build Jellyfin.Plugin.DiscMenus",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet test",
      "type": "shell",
      "command": "docker compose exec dev dotnet test Jellyfin.Plugin.DiscMenus.Tests",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
