<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Phillip Berryman</Copyright>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.AsterTracking</RootNamespace>
    <AssemblyVersion>0.9.7.0</AssemblyVersion>
    <FileVersion>0.9.7.0</FileVersion>
    <Description>Discovery and tracking for Aster Media Player: each person's Discover page, scrobbling to their own accounts, and requests through Seerr.</Description>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

  <!-- Aster's own apps on each service, for official releases only (see BuiltInKeys.cs). The release workflow sets these
       environment variables from the repository's Actions secrets; any build without them has none. -->
  <ItemGroup>
    <AssemblyMetadata Include="AsterKey.SimklClientId" Value="$(ASTER_SIMKL_CLIENT_ID)" Condition="'$(ASTER_SIMKL_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="AsterKey.AniListClientId" Value="$(ASTER_ANILIST_CLIENT_ID)" Condition="'$(ASTER_ANILIST_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="AsterKey.MyAnimeListClientId" Value="$(ASTER_MAL_CLIENT_ID)" Condition="'$(ASTER_MAL_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="AsterKey.HardcoverClientId" Value="$(ASTER_HARDCOVER_CLIENT_ID)" Condition="'$(ASTER_HARDCOVER_CLIENT_ID)' != ''" />
    <AssemblyMetadata Include="AsterKey.LastFmApiKey" Value="$(ASTER_LASTFM_API_KEY)" Condition="'$(ASTER_LASTFM_API_KEY)' != ''" />
    <AssemblyMetadata Include="AsterKey.LastFmSharedSecret" Value="$(ASTER_LASTFM_SHARED_SECRET)" Condition="'$(ASTER_LASTFM_SHARED_SECRET)' != ''" />
  </ItemGroup>

</Project>
